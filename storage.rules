rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Editorial content (lesson videos, etc.) — public read, no client writes.
    // Uploads happen via scripts/upload-lesson-video.mjs using the Admin SDK,
    // which bypasses these rules entirely.
    match /content/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
