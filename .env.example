# Copy to .env.local and fill in. Never commit .env.local.

# --- Firebase (server) ---
# Path to a service-account JSON key. On Firebase App Hosting / Cloud Run the
# attached service account is picked up automatically and this can be omitted.
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_PROJECT_ID=mep-v2

# --- Email (SMTP) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# --- Google / Gemini ---
GEMINI_API_KEY=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Search engine verification -----------------------------------------
# Optional. Each one adds a <meta> tag proving domain ownership to that
# engine's webmaster console; leave blank and no tag is emitted. Google's
# token is already committed in app/layout.tsx.
# Read server-side only, so no NEXT_PUBLIC_ prefix — but they must also be added
# to apphosting.yaml to exist in production.
# Bing Webmaster Tools > Settings > Verification ("msvalidate.01" content).
# Verifying with Bing also covers DuckDuckGo, Ecosia and Yahoo, which use its index.
BING_SITE_VERIFICATION=
# Yandex Webmaster > Site settings > Verification.
YANDEX_SITE_VERIFICATION=

# IndexNow (Bing/Yandex/Seznam/Naver push indexing) needs no key here — the key
# is public by design and lives in lib/indexnow.ts + public/<key>.txt.
# Set INDEXNOW_FORCE=1 to let a non-production build actually submit.
INDEXNOW_FORCE=

# --- PostHog (product analytics) ----------------------------------------
# Leave either value blank and the integration disables itself entirely — no
# events, no errors. That is the intended state for local dev and CI.
# Project settings > Project ID. Public by design: it ships in the browser
# bundle and can only write events, never read them.
NEXT_PUBLIC_POSTHOG_KEY=
# Must match the region the project was created in — https://eu.i.posthog.com
# or https://us.i.posthog.com. The wrong one fails silently, because the other
# region has no such project. Both are already allowed by the CSP in proxy.ts.
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# --- Paddle -------------------------------------------------------------
# Everything below comes from the Paddle dashboard. Leave the client token
# blank and the paywall CTA falls back to entering the platform without
# charging — the app runs fine without Paddle configured.

# "sandbox" (default) or "production". Anything other than the literal string
# "production" is treated as sandbox, so a typo can never take real payments.
NEXT_PUBLIC_PADDLE_ENV=sandbox

# Google Maps — the songwriter map in Connect. Mint the key in Google Cloud on
# a project with billing enabled and "Maps JavaScript API" turned on, and
# restrict it by HTTP referrer to the app's domains (it ships to the browser).
# Unset, the map renders a quiet "not configured" state rather than erroring.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Paddle > Developer tools > Authentication > Client-side tokens (starts "live_" or "test_").
# Public by design — it is embedded in the browser bundle.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=

# Paddle > Catalog > Products > Prices. One price per plan × billing period,
# each looking like "pri_01j...". A plan is only purchasable once its id is set.
NEXT_PUBLIC_PADDLE_PRICE_PRO_YEARLY=
NEXT_PUBLIC_PADDLE_PRICE_PRO_MONTHLY=
NEXT_PUBLIC_PADDLE_PRICE_MAX_YEARLY=
NEXT_PUBLIC_PADDLE_PRICE_MAX_MONTHLY=

# SECRETS — server only, never prefixed with NEXT_PUBLIC_.
# API key: Paddle > Developer tools > Authentication > API keys.
PADDLE_API_KEY=
# Webhook secret: Paddle > Developer tools > Notifications > your destination.
# Points at POST /api/paddle/webhook.
PADDLE_WEBHOOK_SECRET=
