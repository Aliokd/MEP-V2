# Raw lesson video sources — compress and upload via scripts/upload-lesson-video.mjs
# to Firebase Storage instead of committing heavy footage to the repo.
public/videos/Master fundamentals/
*.compressed.mp4

# Practice song masters and their working documents. The app plays the .mp3
# renders only (see app/platform/practice/data/practiceSongs.ts), so the .wav
# masters are 174MB of source material nothing ever requests — and git keeps
# them forever, in every clone and every CI checkout. Keep the masters in
# whatever holds the rest of the session files, not here.
public/Practice/**/*.wav
public/Practice/**/*.docx




vendor/lexicon/nst/

# Onboarding source masters (66MB of raw video/stills from which the webp and
# mp4 derivatives in public/onboarding-cards are generated). Kept out of the
# repo AND off the deployed site: everything under public/ is served publicly,
# and only the derivatives are ever referenced by the app.
/public/Onboarding assets/

# 404 / empty-state source master (the 1 MB PNG the avif+webp in
# public/assets/404 are generated from). Same rule as the onboarding masters:
# everything under public/ is served publicly, and only the derivatives are
# ever referenced by the app.
/public/404 - empty states/

# Create demo-video masters. Same rule again, but listed by file rather than by
# directory because public/Create holds the derivatives the app DOES play
# (collab-loop.mp4, publish-loop.mp4) in the same folder. Only these two
# originals are unreferenced.
/public/Create/Invite collab.mp4
/public/Create/Publish song.mp4

# Internal business documents. This repository is PUBLIC, and a commit is
# permanent — deleting a file later leaves it in the history for anyone who
# clones. Cost models, margins, projections and pricing analysis are the kind of
# thing that gets dropped in the project root while it is being worked on, so
# they are excluded by pattern rather than by remembering each time.
/*.pdf
/*Unit-Economics*
/*unit-economics*

# Learn artwork source masters and stray duplicates. LearnLanding serves only
# the avif/webp derivatives, and builds their names from a template
# (`${base}.avif`, `${base}@2x.avif`) — so a literal grep for a filename finds
# nothing and these read as unused when they are not. The PNGs the derivatives
# are generated from are unused, and everything under public/ is served
# publicly, so they are kept out rather than uploaded on every deploy.
/public/assets/Learn/*.png
/public/assets/Learn/* 2.avif
# Superseded by the -2 artwork above; kept on disk, no longer served.
/public/assets/Learn/bank-of-tips.avif
/public/assets/Learn/bank-of-tips.webp
/public/assets/Learn/fundamentals.avif
/public/assets/Learn/fundamentals.webp
